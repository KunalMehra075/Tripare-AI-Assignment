{
  "name": "tripare-hotel-comparator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Rate Comparator using Temporal Workflows, Node.js, and React",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run worker",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:watch": "npm --prefix backend run test:watch",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build"
  },
  "keywords": ["temporal", "hotel-search", "rate-comparator", "react", "shadcn", "typescript"],
