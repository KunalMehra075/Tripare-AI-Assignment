  "version": "1.0.0",
  "description": "Hotel Rate Comparator backend powered by Temporal SDK and Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
